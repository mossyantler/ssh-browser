{
  "manifest_version": 3,
  "name": "SSH Browser",
  "version": "0.1.0",
  "description": "선택한 SSH 서버의 SOCKS5 터널로 Chrome 트래픽을 연결합니다.",
  "permissions": [
    "storage",
    "proxy",
    "nativeMessaging"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SSH Browser"
  },
  "options_page": "options.html",
  "key": ""
}
